<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sheru AI - Professional Video Studio</title>
    <!-- Tailwind CSS CDN for modern design -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between">

    <!-- Header Section -->
    <header class="border-b border-slate-800 p-6 text-center">
        <h1 class="text-3xl font-extrabold tracking-tight bg-gradient-to-r from-purple-400 to-indigo-500 bg-clip-text text-transparent">Sheru AI Studio</h1>
        <p class="text-sm text-slate-400 mt-1">Transform your text into cinematic AI videos instantly.</p>
    </header>

    <!-- Main Content -->
    <main class="max-w-3xl mx-auto p-6 w-full flex-grow flex flex-col items-center justify-center">
        
        <!-- Input Card -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl w-full">
            <label for="prompt" class="block text-sm font-medium text-slate-300 mb-2">Enter your prompt</label>
            <textarea id="prompt" rows="3" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-4 text-slate-100 focus:outline-none focus:border-indigo-500 transition" placeholder="e.g., Sheru bhai walking through a cyberpunk city at night..."></textarea>
            
            <button onclick="generateVideo()" id="generateBtn" class="mt-4 w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-3 rounded-xl transition shadow-lg shadow-indigo-600/30 cursor-pointer">
                Generate Video 🚀
            </button>
        </div>

        <!-- Loading State (Hidden by default) -->
        <div id="loading" class="hidden mt-8 text-center">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-4 border-indigo-500 border-t-transparent"></div>
            <p class="text-sm text-slate-400 mt-2">Rendering AI video on GPU cloud... Please wait.</p>
        </div>

        <!-- Result Section (Hidden by default) -->
        <div id="resultContainer" class="hidden mt-8 w-full bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl text-center">
            <h2 class="text-lg font-semibold mb-4 text-slate-200">Your Generated Video</h2>
            <video id="resultVideo" controls class="w-full rounded-xl border border-slate-800 max-h-[400px] object-cover"></video>
            
            <!-- Download Button -->
            <a id="downloadBtn" href="#" download="sheru-ai-video.mp4" class="mt-4 inline-block bg-emerald-600 hover:bg-emerald-500 text-white font-medium px-6 py-2.5 rounded-xl transition shadow-lg shadow-emerald-600/30">
                Download Video 📥
            </a>
        </div>

    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 p-4 text-center text-xs text-slate-500">
        Powered by GitHub Pages & Google Colab GPU Backend.
    </footer>

    <!-- JavaScript Handling API Request -->
    <script>
        async function generateVideo() {
            const promptText = document.getElementById('prompt').value.trim();
            if (!promptText) {
                alert('Please enter a prompt first!');
                return;
            }

            // Toggle UI states
            document.getElementById('loading').classList.remove('hidden');
            document.getElementById('resultContainer').classList.add('hidden');
            document.getElementById('generateBtn').disabled = true;

            // ⚠️ REPLACE THIS URL WITH YOUR LIVE NGROK URL FROM GOOGLE COLAB LATER
            const backendURL = "YOUR_NGROK_URL_HERE/generate"; 

            try {
                const response = await fetch(backendURL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: promptText })
                });

                const data = await response.json();

                if (data.video_url) {
                    let videoElement = document.getElementById('resultVideo');
                    videoElement.src = data.video_url;
                    
                    // Set download link target
                    document.getElementById('downloadBtn').href = data.video_url;

                    document.getElementById('loading').classList.add('hidden');
                    document.getElementById('resultContainer').classList.remove('hidden');
                } else {
                    alert('Video generation failed on backend.');
                    document.getElementById('loading').classList.add('hidden');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Could not connect to the backend server. Make sure your Google Colab notebook is running and Ngrok URL is updated!');
                document.getElementById('loading').classList.add('hidden');
            } finally {
                document.getElementById('generateBtn').disabled = false;
            }
        }
    </script>
</body>
</html>
